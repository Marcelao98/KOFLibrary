package nucleo

// Acha as bordas brancas (ou pretas) da página de mangá pra cortar: tudo que tem a
// mesma cor do canto, nas quatro beiradas, sai. px = RGBA de uma cópia pequena da página.
class Bordas {
    // devolve [x0, y0, x1, y1] do conteúdo (x1/y1 exclusivos)
    public static Int[] medir(Int[] px, Int w, Int h) {
        var r = new Int[4]
        r[0] = 0
        r[1] = 0
        r[2] = w
        r[3] = h
        if (w < 8 || h < 8) { return r }
        var fundo = luz(px, 0)
        var x0 = 0
        while (x0 < w / 3 && colunaVazia(px, w, h, x0, fundo)) { x0++ }
        var x1 = w
        while (x1 > w * 2 / 3 && colunaVazia(px, w, h, x1 - 1, fundo)) { x1-- }
        var y0 = 0
        while (y0 < h / 3 && linhaVazia(px, w, y0, x0, x1, fundo)) { y0++ }
        var y1 = h
        while (y1 > h * 2 / 3 && linhaVazia(px, w, y1 - 1, x0, x1, fundo)) { y1-- }
        // um respiro de 1% pra não colar no desenho
        var mx = w / 100
        var my = h / 100
        r[0] = max(0, x0 - mx)
        r[1] = max(0, y0 - my)
        r[2] = min(w, x1 + mx)
        r[3] = min(h, y1 + my)
        return r
    }

    static Int luz(Int[] px, Int i) {
        return (px[i] * 77 + px[i + 1] * 151 + px[i + 2] * 28) / 256
    }

    // vazia = no máximo 1 ponto em 100 diferente do fundo (sujeira de scan não conta)
    static Bool colunaVazia(Int[] px, Int w, Int h, Int x, Int fundo) {
        var dif = 0
        var y = 0
        while (y < h) {
            var d = luz(px, (y * w + x) * 4) - fundo
            if (d > 40 || d < -40) { dif++ }
            y++
        }
        return dif * 100 <= h
    }

    static Bool linhaVazia(Int[] px, Int w, Int y, Int x0, Int x1, Int fundo) {
        var dif = 0
        var x = x0
        while (x < x1) {
            var d = luz(px, (y * w + x) * 4) - fundo
            if (d > 40 || d < -40) { dif++ }
            x++
        }
        return dif * 100 <= (x1 - x0)
    }

    static Int max(Int a, Int b) { if (a > b) { return a } return b }
    static Int min(Int a, Int b) { if (a < b) { return a } return b }
}
