package nucleo

// Contas do progresso de leitura.
class Leitura {
    // 0..100
    public static Int porcento(Int pagina, Int total) {
        if (total <= 1) { return 0 }
        if (pagina >= total) { return 100 }
        return (pagina - 1) * 100 / (total - 1)
    }

    // "40 s", "12 min", "2 h 05 min"
    public static String tempo(Int segundos) {
        if (segundos < 60) { return segundos + " s" }
        var min = segundos / 60
        if (min < 60) { return min + " min" }
        var h = min / 60
        var m = min % 60
        var mm = "" + m
        if (m < 10) { mm = "0" + m }
        return h + " h " + mm + " min"
    }

    // quanto falta, pelo seu ritmo (sem ritmo ainda: 90 s por página)
    public static String faltam(Int pagina, Int total, Int segundosLidos, Int paginasLidas) {
        var ritmo = 90
        if (paginasLidas >= 3 && segundosLidos > 0) { ritmo = segundosLidos / paginasLidas }
        if (ritmo < 10) { ritmo = 10 }
        if (ritmo > 600) { ritmo = 600 }
        var resta = total - pagina
        if (resta <= 0) { return "última página" }
        return "faltam ~" + tempo(resta * ritmo)
    }
}
